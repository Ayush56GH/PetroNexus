# PetroNexus Environment Configuration (SIH26121)
# Oil India Limited - Nearby Well Intelligence Platform

# Application
PROJECT_NAME="PetroNexus"
PROJECT_TAGLINE="Connect the Well. Remember the Past. Anticipate the Next."
VERSION="1.0.0"

# JWT Security
SECRET_KEY="petronexus-super-secure-production-ready-jwt-key-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite with spatial haversine fallback, or PostgreSQL + PostGIS)
# For local development:
DATABASE_URL="sqlite:///./petronexus.db"
# For production PostgreSQL + PostGIS:
# DATABASE_URL="postgresql://petronexus:OilIndia2026@localhost:5432/petronexus_db"

# xAI / Grok API Integration
# When left empty, PetroNexus runs in High-Fidelity Grounded Demo Mode with zero hallucinations
XAI_API_KEY=""
GROK_MODEL="grok-2-latest"
