# PetroNexus Environment Configuration (SIH26121)
# Oil India Limited - Nearby Well Intelligence Platform

PROJECT_NAME="PetroNexus"
PROJECT_TAGLINE="Connect the Well. Remember the Past. Anticipate the Next."
VERSION="1.0.0"

SECRET_KEY="your-secret-key-here"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Supabase Auth & Project Configuration
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_KEY="your-supabase-publishable-key"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Database Connection (Supabase PostgreSQL + PostGIS + pgvector)
DATABASE_URL="postgresql+psycopg://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

# Local Embeddings (BAAI/bge-small-en-v1.5, 384 dims, zero external API key)
EMBEDDING_PROVIDER="local"
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
EMBEDDING_DIMENSION=384

# Active LLM Provider ("groq", "xai", "openai", "gemini", or "none")
LLM_PROVIDER="groq"

# Groq LLM API Configuration
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# xAI / Grok LLM (Preserved)
XAI_API_KEY=""
GROK_MODEL="grok-2-latest"

# WITSML / eRTMAC Live Telemetry Configuration (SIH 26121 Section 5 & 90)
WITSML_URL="https://ertmac.oilindia.in/witsml/1.4.1.1"
WITSML_USERNAME="oil_engineer"
WITSML_PASSWORD=""
ERTMAC_URL="https://ertmac.oilindia.in/api/v1/telemetry"
ERTMAC_API_KEY=""

# Data and Document Storage Paths
DATA_STORAGE_PATH="./data"
DOCUMENT_STORAGE_PATH="./documents"
